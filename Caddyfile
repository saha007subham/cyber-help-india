{
    admin off
    auto_https off
    log {
        level WARN
    }
}

:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    # Block sensitive paths and files
    @blocked path /app/* /storage/* /database/* /tests/* /composer.* /README.md /Caddyfile
    respond @blocked 404

    # Block hidden files (dotfiles like /.htaccess, /.env)
    @dotfiles path_regexp (/\..*)
    respond @dotfiles 404

    # Security headers for all responses
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Execute PHP and route all non-static requests to /index.php
    php_server
}
